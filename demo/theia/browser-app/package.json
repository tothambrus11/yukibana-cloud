{
  "name": "browser-app",
  "private": true,
  "version": "0.1.0",
  "theia": {
    "target": "browser",
    "frontend": {
      "config": {
        "applicationName": "Yukibana (update prototype)",
        "preferences": {
          "security.workspace.trust.enabled": false
        }
      }
    }
  },
  "dependencies": {
    "@theia/core": "1.76.0",
    "@theia/editor": "1.76.0",
    "@theia/filesystem": "1.76.0",
    "@theia/markers": "1.76.0",
    "@theia/messages": "1.76.0",
    "@theia/monaco": "1.76.0",
    "@theia/navigator": "1.76.0",
    "@theia/preferences": "1.76.0",
    "@theia/process": "1.76.0",
    "@theia/scm": "1.76.0",
    "@theia/terminal": "1.76.0",
    "@theia/workspace": "1.76.0",
    "yukibana-update": "0.1.0"
  },
  "devDependencies": {
    "@theia/cli": "1.76.0"
  },
  "scripts": {
    "build": "theia build --mode development",
    "start": "theia start --hostname 127.0.0.1 --port 3000"
  }
}
