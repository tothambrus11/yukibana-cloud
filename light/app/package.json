{
	"name": "yukibana-monaco-lsp",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node scripts/licenses.mjs && node scripts/compress.mjs && node scripts/offline-manifest.mjs",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p src/service-worker --noEmit && node ../modules/typecheck.mjs",
		"prepare": "svelte-kit sync",
		"test:unit": "node --test \"tests/unit/*.test.mjs\" \"../modules/**/*.test.mjs\"",
		"test:e2e": "node tests/e2e.mjs",
		"test:e2e:targets": "node tests/e2e-targets.mjs",
		"test:e2e:layout": "node tests/e2e-layout.mjs",
		"test:e2e:links": "node tests/e2e-links.mjs",
		"test:e2e:debug": "node tests/e2e-debug.mjs",
		"test:export": "node tests/export.mjs",
		"test:export:ci": "node tests/export-ci.mjs"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "4.0.0",
		"@sveltejs/kit": "3.1.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@types/node": "24.19.2",
		"playwright-core": "1.56.1",
		"svelte": "5.57.2",
		"svelte-check": "4.7.7",
		"typescript": "6.0.3",
		"vite": "8.3.5"
	},
	"dependencies": {
		"@yukibana/core": "link:../modules/core",
		"@yukibana/design": "github:Yukibana-Ed/Yukibana#8462e17ba26df25575735fad414052bd56a7f383&path:packages/design",
		"@yukibana/lang-cpp": "link:../modules/lang-cpp",
		"@yukibana/lang-go": "link:../modules/lang-go",
		"@yukibana/lang-haskell": "link:../modules/lang-haskell",
		"@yukibana/lang-java": "link:../modules/lang-java",
		"@yukibana/lang-javascript": "link:../modules/lang-javascript",
		"@yukibana/lang-kotlin": "link:../modules/lang-kotlin",
		"@yukibana/lang-php": "link:../modules/lang-php",
		"@yukibana/lang-python": "link:../modules/lang-python",
		"@yukibana/lang-rust": "link:../modules/lang-rust",
		"@yukibana/lang-scala": "link:../modules/lang-scala",
		"@yukibana/lang-swift": "link:../modules/lang-swift",
		"@yukibana/lang-zig": "link:../modules/lang-zig",
		"@yukibana/monaco": "link:../modules/monaco",
		"@yukibana/protocol": "link:../modules/protocol",
		"@yukibana/runtime": "link:../modules/runtime",
		"@yukibana/std": "link:../modules/std",
		"arktype": "2.2.9",
		"dockview": "8.6.1",
		"monaco-editor": "0.57.0",
		"vscode-languageserver-protocol": "3.17.5"
	}
}
