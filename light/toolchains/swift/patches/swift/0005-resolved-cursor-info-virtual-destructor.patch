+//===--- ResolvedCursorInfoTest.cpp ---------------------------------------===//
+//
+// This source file is part of the Swift.org open source project
+//
+// Copyright (c) 2026 Apple Inc. and the Swift project authors
+// Licensed under Apache License v2.0 with Runtime Library Exception
+//
+// See https://swift.org/LICENSE.txt for license information
+// See https://swift.org/CONTRIBUTORS.txt for the list of Swift project authors
+//
+//===----------------------------------------------------------------------===//
+
+#include "swift/IDE/Utils.h"
+#include "gtest/gtest.h"
+
+using namespace swift;
+using namespace swift::ide;
+
+namespace {
+/// A subclass that records whether its destructor ran.
+struct DestructionProbe : public ResolvedCursorInfo {
+  bool &Destroyed;
+  explicit DestructionProbe(bool &Destroyed)
+      : ResolvedCursorInfo(CursorInfoKind::ValueRef, nullptr, SourceLoc()),
+        Destroyed(Destroyed) {}
+  ~DestructionProbe() { Destroyed = true; }
+};
+} // namespace
+
+TEST(ResolvedCursorInfo, ReleasingThroughBasePointerDestroysSubclass) {
+  bool Destroyed = false;
+  {
+    ResolvedCursorInfoPtr Info = new DestructionProbe(Destroyed);
+    EXPECT_FALSE(Destroyed);
+  }
+  EXPECT_TRUE(Destroyed);
+}
+
+// Without a virtual destructor this leaks ReceiverTypes' heap buffer and is a
+// new-delete-type-mismatch (232 bytes allocated, 24 freed on a 64-bit host);
+// it only fails under AddressSanitizer or LeakSanitizer.
+TEST(ResolvedCursorInfo, ReleasingValueRefThroughBasePointer) {
+  SmallVector<NominalTypeDecl *> ReceiverTypes(16, nullptr);
+  ResolvedCursorInfoPtr Info = new ResolvedValueRefCursorInfo(
+      /*SF=*/nullptr, SourceLoc(), /*ValueD=*/nullptr, /*CtorTyRef=*/nullptr,
+      /*ExtTyRef=*/nullptr, /*IsRef=*/true,
+      /*SolutionSpecificInterfaceType=*/Type(), /*ContainerType=*/Type(),
+      /*CustomAttrRef=*/std::nullopt, /*IsKeywordArgument=*/false,
+      /*IsDynamic=*/true, ReceiverTypes, /*ShorthandShadowedDecls=*/{});
+  EXPECT_TRUE(isa<ResolvedValueRefCursorInfo>(Info.get()));
+  Info.reset();
+}
