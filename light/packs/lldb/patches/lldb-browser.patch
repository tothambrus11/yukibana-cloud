diff --git a/lldb/source/Plugins/Process/gdb-remote/ConnectionSharedRing.cpp b/lldb/source/Plugins/Process/gdb-remote/ConnectionSharedRing.cpp
new file mode 100644
index 0000000..a41b979
--- /dev/null
+++ b/lldb/source/Plugins/Process/gdb-remote/ConnectionSharedRing.cpp
@@ -0,0 +1,183 @@
+//===-- ConnectionSharedRing.cpp ------------------------------------------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+
+#ifdef __EMSCRIPTEN__
+
+#include "ConnectionSharedRing.h"
+#include "lldb/Utility/Status.h"
+#include "lldb/Utility/Timeout.h"
+
+#include <emscripten/emscripten.h>
+#include <emscripten/threading.h>
+
+#include <algorithm>
+#include <cerrno>
+#include <cmath>
+#include <chrono>
+#include <cstring>
+
+using namespace lldb;
+using namespace lldb_private;
+
+namespace {
+
+// The layout the stub reads (light/packs/lldb/src/channel.js): a header of
+// four u32 (magic, ring size, offset of the ring to the stub, offset of the
+// ring to LLDB), then the two rings. A ring is head (bytes ever written),
+// tail (bytes ever read), closed (nonzero once its writer is gone) and the
+// data, a power of two long; both counters wrap at 2^32, so the bytes waiting
+// are head - tail in unsigned arithmetic. Each side waits on the word the
+// other changes: a reader on head, a writer with a full ring on tail.
+constexpr uint32_t kMagic = 0x796b6462; // "bdky"
+constexpr uint32_t kRingSize = 1u << 16;
+
+struct Ring {
+  std::atomic<uint32_t> head;
+  std::atomic<uint32_t> tail;
+  std::atomic<uint32_t> closed;
+  uint32_t reserved;
+  uint8_t data[kRingSize];
+};
+
+struct Channel {
+  uint32_t magic;
+  uint32_t ring_size;
+  uint32_t to_stub_offset;
+  uint32_t to_lldb_offset;
+  Ring to_stub;
+  Ring to_lldb;
+};
+
+alignas(16) Channel g_channel;
+
+void Wake(std::atomic<uint32_t> &word) {
+  emscripten_futex_wake(reinterpret_cast<volatile void *>(&word), INT32_MAX);
+}
+
+// Waits while word == seen, for at most ms (negative: without end).
+void WaitWhile(std::atomic<uint32_t> &word, uint32_t seen, double ms) {
+  emscripten_futex_wait(reinterpret_cast<volatile void *>(&word), seen,
+                        ms < 0 ? INFINITY : ms);
+}
+
+} // namespace
+
+/// The channel's address, for the page to give the stub with this module's
+/// memory. It is a static: one LLDB debugs one program at a time.
+extern "C" EMSCRIPTEN_KEEPALIVE void *yukibana_debug_channel() {
+  if (g_channel.magic != kMagic) {
+    g_channel.ring_size = kRingSize;
+    g_channel.to_stub_offset = offsetof(Channel, to_stub);
+    g_channel.to_lldb_offset = offsetof(Channel, to_lldb);
+    g_channel.magic = kMagic;
+  }
+  return &g_channel;
+}
+
+ConnectionStatus ConnectionSharedRing::Connect(llvm::StringRef url,
+                                               Status *error_ptr) {
+  if (url != kURL) {
+    if (error_ptr)
+      *error_ptr = Status::FromErrorStringWithFormatv(
+          "unsupported connection URL: '{0}'", url);
+    return eConnectionStatusError;
+  }
+  // The page resets the rings before each session (channel.js, reset), so
+  // nothing from an earlier program is read as this one's.
+  yukibana_debug_channel();
+  m_interrupted = false;
+  m_connected = true;
+  return eConnectionStatusSuccess;
+}
+
+ConnectionStatus ConnectionSharedRing::Disconnect(Status *error_ptr) {
+  if (m_connected.exchange(false)) {
+    g_channel.to_stub.closed.store(1);
+    Wake(g_channel.to_stub.head);
+  }
+  return eConnectionStatusSuccess;
+}
+
+size_t ConnectionSharedRing::Read(void *dst, size_t dst_len,
+                                  const Timeout<std::micro> &timeout,
+                                  ConnectionStatus &status,
+                                  Status *error_ptr) {
+  Ring &ring = g_channel.to_lldb;
+  auto deadline = timeout ? std::chrono::steady_clock::now() + *timeout
+                          : std::chrono::steady_clock::time_point::max();
+  while (true) {
+    uint32_t head = ring.head.load();
+    uint32_t tail = ring.tail.load();
+    if (head != tail) {
+      size_t n = std::min<size_t>(dst_len, head - tail);
+      for (size_t i = 0; i < n; ++i)
+        static_cast<uint8_t *>(dst)[i] = ring.data[(tail + i) & (kRingSize - 1)];
+      ring.tail.store(tail + n);
+      Wake(ring.tail);
+      status = eConnectionStatusSuccess;
+      return n;
+    }
+    if (ring.closed.load() || !m_connected) {
+      status = eConnectionStatusEndOfFile;
+      return 0;
+    }
+    if (m_interrupted.exchange(false)) {
+      status = eConnectionStatusInterrupted;
+      return 0;
+    }
+    double ms = -1;
+    if (timeout) {
+      auto left = deadline - std::chrono::steady_clock::now();
+      if (left <= std::chrono::steady_clock::duration::zero()) {
+        status = eConnectionStatusTimedOut;
+        return 0;
+      }
+      ms = std::chrono::duration<double, std::milli>(left).count();
+    }
+    WaitWhile(ring.head, head, ms);
+  }
+}
+
+size_t ConnectionSharedRing::Write(const void *src, size_t src_len,
+                                   ConnectionStatus &status,
+                                   Status *error_ptr) {
+  Ring &ring = g_channel.to_stub;
+  size_t done = 0;
+  while (done < src_len) {
+    if (!m_connected || g_channel.to_lldb.closed.load()) {
+      status = eConnectionStatusLostConnection;
+      if (error_ptr)
+        *error_ptr = Status::FromErrorString("the program is gone");
+      return done;
+    }
+    uint32_t head = ring.head.load();
+    uint32_t tail = ring.tail.load();
+    uint32_t space = kRingSize - (head - tail);
+    if (space == 0) {
+      WaitWhile(ring.tail, tail, 100);
+      continue;
+    }
+    size_t n = std::min<size_t>(space, src_len - done);
+    for (size_t i = 0; i < n; ++i)
+      ring.data[(head + i) & (kRingSize - 1)] =
+          static_cast<const uint8_t *>(src)[done + i];
+    ring.head.store(head + n);
+    Wake(ring.head);
+    done += n;
+  }
+  status = eConnectionStatusSuccess;
+  return done;
+}
+
+bool ConnectionSharedRing::InterruptRead() {
+  m_interrupted = true;
+  Wake(g_channel.to_lldb.head);
+  return true;
+}
+
+#endif // __EMSCRIPTEN__
diff --git a/lldb/source/Plugins/Process/gdb-remote/ConnectionSharedRing.h b/lldb/source/Plugins/Process/gdb-remote/ConnectionSharedRing.h
new file mode 100644
index 0000000..c5e7850
--- /dev/null
+++ b/lldb/source/Plugins/Process/gdb-remote/ConnectionSharedRing.h
@@ -0,0 +1,53 @@
+//===-- ConnectionSharedRing.h ----------------------------------*- C++ -*-===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// Yukibana Light: the gdb-remote connection of an LLDB compiled to
+// WebAssembly with Emscripten, to a stub running in another Web Worker. A
+// browser has no sockets and no pipes between workers, so the bytes go
+// through two rings in this module's own memory (a SharedArrayBuffer): the
+// page posts that buffer and the address of yukibana_debug_channel() to the
+// stub, which reads and writes the rings with Atomics, and blocks with
+// Atomics.wait while the program it debugs is stopped. Connect to it with the
+// URL "yukibana://".
+//
+//===----------------------------------------------------------------------===//
+
+#ifndef LLDB_SOURCE_PLUGINS_PROCESS_GDB_REMOTE_CONNECTIONSHAREDRING_H
+#define LLDB_SOURCE_PLUGINS_PROCESS_GDB_REMOTE_CONNECTIONSHAREDRING_H
+
+#ifdef __EMSCRIPTEN__
+
+#include "lldb/Utility/Connection.h"
+#include <atomic>
+
+namespace lldb_private {
+
+class ConnectionSharedRing : public Connection {
+public:
+  static constexpr llvm::StringLiteral kURL = "yukibana://";
+
+  lldb::ConnectionStatus Connect(llvm::StringRef url,
+                                 Status *error_ptr) override;
+  lldb::ConnectionStatus Disconnect(Status *error_ptr) override;
+  bool IsConnected() const override { return m_connected; }
+  size_t Read(void *dst, size_t dst_len, const Timeout<std::micro> &timeout,
+              lldb::ConnectionStatus &status, Status *error_ptr) override;
+  size_t Write(const void *src, size_t src_len, lldb::ConnectionStatus &status,
+               Status *error_ptr) override;
+  std::string GetURI() override { return kURL.str(); }
+  bool InterruptRead() override;
+
+private:
+  std::atomic<bool> m_connected{false};
+  std::atomic<bool> m_interrupted{false};
+};
+
+} // namespace lldb_private
+
+#endif // __EMSCRIPTEN__
+#endif
