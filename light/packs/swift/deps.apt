# Debian/Ubuntu packages build.sh needs beyond git, curl, python3, make and
# Node (light/setup.sh installs them, and so does CI): what the Swift
# toolchain for Ubuntu 24.04, which build.sh downloads, links against.
binutils
libc6-dev
libcurl4-openssl-dev
libedit2
libgcc-13-dev
libncurses-dev
libpython3-dev
libsqlite3-0
libstdc++-13-dev
libxml2-dev
libz3-dev
pkg-config
tzdata
unzip
zlib1g-dev
