# Debian/Ubuntu packages build.sh needs beyond git, curl, python3, make and
# Node (light/setup.sh installs them, and so does CI). Tested on Ubuntu 24.04.
# build.sh: clang, cmake, ninja.
clang
cmake
ninja-build
lld
llvm
# build-vm.sh: clang-18, clang-tidy-18 and llvm-strip build QEMU and the
# kernels; flex, bison, bc and libelf (objtool) the x86-64 kernel; cpio the
# initramfs; autoconf, automake, libtool, libltdl-dev (LT_SYS_SYMBOL_USCORE,
# which is in ltdl.m4), pkg-config and python3-venv (meson) QEMU's
# dependencies; jq the build's manifests.
clang-18
clang-tidy-18
flex
bison
bc
cpio
autoconf
automake
libtool
libltdl-dev
pkg-config
jq
libelf-dev
python3-venv
