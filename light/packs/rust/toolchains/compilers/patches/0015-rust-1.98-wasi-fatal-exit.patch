 impl FatalError {
     pub fn raise(self) -> ! {
+        // WASI cannot unwind (panic=abort): unwinding to the driver would trap.
+        // Finish the session's diagnostics here and exit as the driver would.
+        #[cfg(target_os = "wasi")]
+        {
+            if let Some(finish) = WASI_FINISH.with(|f| f.take()) {
+                // SAFETY: set by `on_wasi_fatal_exit`, which clears it before
+                // the closure it points to goes away.
+                unsafe { (*finish)() };
+            }
+            std::process::exit(1);
+        }
+        #[cfg(not(target_os = "wasi"))]
         std::panic::resume_unwind(Box::new(FatalErrorMarker))
     }
 }
 
+#[cfg(target_os = "wasi")]
+thread_local! {
+    static WASI_FINISH: std::cell::Cell<Option<*const (dyn Fn() + 'static)>> =
+        const { std::cell::Cell::new(None) };
+}
+
+/// Runs `f`; a fatal error inside it calls `finish` (the session's final
+/// diagnostics) and exits with status 1. Only on WASI, which cannot unwind.
+#[cfg(target_os = "wasi")]
+pub fn on_wasi_fatal_exit<R>(finish: &dyn Fn(), f: impl FnOnce() -> R) -> R {
+    // SAFETY: the pointer is cleared below, before `finish` goes out of scope;
+    // `raise` takes it out before calling it.
+    let finish: *const (dyn Fn() + '_) = finish;
+    let finish: *const (dyn Fn() + 'static) = unsafe { std::mem::transmute(finish) };
+    let outer = WASI_FINISH.with(|f| f.replace(Some(finish)));
+    let result = f();
+    WASI_FINISH.with(|f| f.set(outer));
+    result
+}
