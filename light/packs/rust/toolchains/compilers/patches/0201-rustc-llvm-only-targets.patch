-                               {{lld::Gnu, &lld::elf::link}, {lld::Wasm, &lld::wasm::link}});
+                               {
+#ifndef RUST_LLD_WASM_ONLY
+                                   {lld::Gnu, &lld::elf::link},
+#endif
+                                   {lld::Wasm, &lld::wasm::link}});
     return result.retCode;
 }
