@@ -1006,6 +1006,28 @@ fn link_natively(

     // Invoke the system linker
     info!("{cmd:?}");
+
+    // A WASI-hosted rustc cannot spawn rust-lld. Link through the bundled LLD
+    // entrypoint, preserving the same argv that the native path would pass.
+    #[cfg(target_os = "wasi")]
+    if matches!(flavor, LinkerFlavor::Gnu(Cc::No, Lld::Yes) | LinkerFlavor::WasmLld(Cc::No)) {
+        unsafe extern "C" {
+            fn RustRunLld(
+                argc: std::ffi::c_int,
+                argv: *const *const std::ffi::c_char,
+            ) -> std::ffi::c_int;
+        }
+        let command = cmd.command();
+        let mut args = command
+            .get_args()
+            .map(|arg| std::ffi::CString::new(arg.as_encoded_bytes()).unwrap())
+            .collect::<Vec<_>>();
+        args.insert(0, std::ffi::CString::new(command.get_program().as_encoded_bytes()).unwrap());
+        let argv = args.iter().map(|arg| arg.as_ptr()).collect::<Vec<_>>();
+        let status = unsafe { RustRunLld(args.len() as std::ffi::c_int, argv.as_ptr()) };
+        std::process::exit(status);
+    }
+
     let unknown_arg_regex =
         Regex::new(r"(unknown|unrecognized) (command line )?(option|argument)").unwrap();
     let mut prog;
