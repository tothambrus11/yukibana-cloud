@@ -0,0 +1,42 @@
+package org.javacs.kt.util
+
+import java.util.concurrent.Executor
+
+/**
+ * Yukibana: when the system property kotlinLanguageServer.singleThreaded is set, the server
+ * starts no thread (GraalVM Web Image, in a browser, has one). Async work runs at once, on the
+ * caller's thread, so a request's future is complete when its handler returns; debounced work
+ * waits until the host calls [runPending], when it has no message to deliver.
+ */
+object SingleThread {
+    @JvmStatic val enabled: Boolean = System.getProperty("kotlinLanguageServer.singleThreaded") != null
+
+    /** Runs a task on the calling thread. */
+    @JvmStatic val direct: Executor = Executor { it.run() }
+
+    private val pending = LinkedHashMap<Any, () -> Unit>()
+
+    /** Runs task later, in place of any task still pending for the same owner. */
+    @JvmStatic fun defer(owner: Any, task: () -> Unit) {
+        pending.remove(owner)
+        pending[owner] = task
+    }
+
+    /** Runs a task, logging what it throws, as an executor's thread would have dropped it. */
+    @JvmStatic fun runLogged(task: () -> Unit) {
+        try {
+            task()
+        } catch (e: Exception) {
+            org.javacs.kt.LOG.warn("Background task failed: {}", e.toString())
+        }
+    }
+
+    /** Runs the tasks pending now, in the order they were deferred; false if there were none. */
+    @JvmStatic fun runPending(): Boolean {
+        if (pending.isEmpty()) return false
+        val tasks = pending.values.toList()
+        pending.clear()
+        tasks.forEach { it() }
+        return true
+    }
+}
