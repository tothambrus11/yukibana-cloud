{
	// The shared modules, checked as one project from light/app
	// (`npm run check` runs `tsc -p ../modules`), with the app's TypeScript
	// and type packages: the modules have no node_modules of their own.
	//
	// erasableSyntaxOnly and allowImportingTsExtensions keep every file
	// loadable as it is by Node's type stripping (the unit tests), Vite and
	// esbuild (the packs' glue): no enums, namespaces or parameter
	// properties, and relative imports name the .ts file.
	"compilerOptions": {
		"target": "es2024",
		"module": "esnext",
		"moduleResolution": "bundler",
		"lib": ["es2024", "DOM", "DOM.Iterable", "WebWorker"],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"noImplicitOverride": true,
		"noFallthroughCasesInSwitch": true,
		"erasableSyntaxOnly": true,
		"verbatimModuleSyntax": true,
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"types": ["node"],
		"typeRoots": ["../app/node_modules/@types"],
		// monaco's `import type` only (H1: the host's Monaco is injected,
		// never bundled), resolved from the app's installed copy.
		"paths": {
			"monaco-editor": ["../app/node_modules/monaco-editor"]
		}
	},
	"include": ["protocol", "runtime", "monaco"]
}
