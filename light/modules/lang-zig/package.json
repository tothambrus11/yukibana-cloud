{
	"name": "@yukibana/lang-zig",
	"version": "0.1.0",
	"private": true,
	"description": "Zig in Yukibana Light: the language's description and its providers (cheap to import), its body (the sample project, its server's settings and its build settings) and what Monaco needs of it, each its own entry point.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tothambrus11/yukibana-cloud.git",
		"directory": "light/modules/lang-zig"
	},
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"@yukibana/source": "./index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./body": {
			"@yukibana/source": "./body.ts",
			"types": "./dist/body.d.ts",
			"default": "./dist/body.js"
		},
		"./monaco": {
			"@yukibana/source": "./monaco.ts",
			"types": "./dist/monaco.d.ts",
			"default": "./dist/monaco.js"
		}
	},
	"files": [
		"dist",
		"*.ts",
		"README.md"
	],
	"dependencies": {
		"@yukibana/std": "^0.1.0"
	},
	"peerDependencies": {
		"@yukibana/core": "^0.1.0",
		"monaco-editor": ">=0.57.0"
	}
}
