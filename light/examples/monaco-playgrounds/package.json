{
	"name": "yukibana-example-monaco-playgrounds",
	"private": true,
	"version": "0.0.0",
	"description": "Three C++ playgrounds in one Monaco on one page, each with a language server of its own answering in its own editor alone: one createPlayground call each (@yukibana/playground).",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"check": "tsc -p . && tsc -p tsconfig.node.json",
		"test:e2e": "node test.mjs"
	},
	"dependencies": {
		"@yukibana/core": "link:../../modules/core",
		"@yukibana/lang-cpp": "link:../../modules/lang-cpp",
		"@yukibana/monaco": "link:../../modules/monaco",
		"@yukibana/playground": "link:../../modules/playground",
		"@yukibana/protocol": "link:../../modules/protocol",
		"@yukibana/runtime": "link:../../modules/runtime",
		"@yukibana/std": "link:../../modules/std",
		"monaco-editor": "0.57.0"
	},
	"devDependencies": {
		"@types/node": "24.19.2",
		"playwright-core": "1.56.1",
		"typescript": "6.0.3",
		"vite": "8.3.5"
	}
}
