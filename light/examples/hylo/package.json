{
	"name": "yukibana-example-hylo",
	"private": true,
	"version": "0.0.0",
	"description": "A docs page of Hylo snippets running Hylo's own compiler, bundled by the page, through one Yukibana runner pool (step HY1).",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"check": "tsc -p . && tsc -p tsconfig.node.json",
		"test": "node --test \"tests/*.test.mjs\"",
		"test:e2e": "node tests/e2e.mjs"
	},
	"dependencies": {
		"@hylo-lang/hylo-wasm": "0.0.9",
		"@yukibana/protocol": "file:../../modules/protocol",
		"@yukibana/runtime": "file:../../modules/runtime"
	},
	"devDependencies": {
		"@types/node": "24.19.2",
		"playwright-core": "1.56.1",
		"typescript": "6.0.3",
		"vite": "8.3.5"
	}
}
