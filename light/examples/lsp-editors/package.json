{
	"name": "yukibana-example-lsp-editors",
	"private": true,
	"version": "0.0.0",
	"description": "The packs' language servers in two editors: Monaco through @yukibana/monaco's MonacoBinding, and a plain textarea through @yukibana/editors/textarea with diagnostics, hover, completion and go to definition drawn by the page.",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"check": "tsc -p . && tsc -p tsconfig.node.json",
		"test": "node --test \"tests/*.test.mjs\"",
		"test:e2e": "node test.mjs"
	},
	"dependencies": {
		"@yukibana/core": "file:../../modules/core",
		"@yukibana/editors": "file:../../modules/editors",
		"@yukibana/lang-cpp": "file:../../modules/lang-cpp",
		"@yukibana/lang-go": "file:../../modules/lang-go",
		"@yukibana/lang-javascript": "file:../../modules/lang-javascript",
		"@yukibana/lang-python": "file:../../modules/lang-python",
		"@yukibana/lang-rust": "file:../../modules/lang-rust",
		"@yukibana/monaco": "file:../../modules/monaco",
		"@yukibana/protocol": "file:../../modules/protocol",
		"@yukibana/runtime": "file:../../modules/runtime",
		"@yukibana/std": "file:../../modules/std",
		"monaco-editor": "0.57.0"
	},
	"devDependencies": {
		"@types/node": "24.19.2",
		"playwright-core": "1.56.1",
		"typescript": "6.0.3",
		"vite": "8.3.5"
	}
}
