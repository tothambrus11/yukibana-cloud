{
	"name": "yukibana-example-cpp-library-sveltekit",
	"private": true,
	"version": "0.0.0",
	"description": "The cpp-library example as a SvelteKit app: a <CppPlayground> component over one createPlayground call (@yukibana/playground), C++ in Monaco against a library of one's own, the language server's answers in the editor and Run. The page prerenders; Monaco loads in the browser.",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"test:e2e": "node test.mjs"
	},
	"dependencies": {
		"@yukibana/core": "link:../../modules/core",
		"@yukibana/lang-cpp": "link:../../modules/lang-cpp",
		"@yukibana/monaco": "link:../../modules/monaco",
		"@yukibana/playground": "link:../../modules/playground",
		"@yukibana/protocol": "link:../../modules/protocol",
		"@yukibana/runtime": "link:../../modules/runtime",
		"@yukibana/std": "link:../../modules/std",
		"monaco-editor": "0.57.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "4.0.0",
		"@sveltejs/kit": "3.1.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@types/node": "24.19.2",
		"playwright-core": "1.56.1",
		"svelte": "5.57.2",
		"svelte-check": "4.7.7",
		"typescript": "6.0.3",
		"vite": "8.3.5"
	}
}
