{
	"name": "yukibana-example-codemirror-playgrounds",
	"private": true,
	"version": "0.0.0",
	"description": "Several C++ playgrounds on one page in CodeMirror 6, each with its own language server answering in its own editor alone, and Run: createPlayground of @yukibana/playground/codemirror, once per snippet.",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"check": "tsc -p . && tsc -p tsconfig.node.json",
		"test:e2e": "node test.mjs"
	},
	"dependencies": {
		"@codemirror/autocomplete": "6.20.4",
		"@codemirror/lang-cpp": "6.0.3",
		"@codemirror/language": "6.13.1",
		"@codemirror/lint": "6.9.7",
		"@codemirror/state": "6.7.6",
		"@codemirror/view": "6.43.15",
		"@lezer/highlight": "1.2.5",
		"@yukibana/codemirror": "link:../../modules/codemirror",
		"@yukibana/core": "link:../../modules/core",
		"@yukibana/lang-cpp": "link:../../modules/lang-cpp",
		"@yukibana/playground": "link:../../modules/playground",
		"@yukibana/protocol": "link:../../modules/protocol",
		"@yukibana/runtime": "link:../../modules/runtime",
		"@yukibana/std": "link:../../modules/std",
		"codemirror": "6.0.2"
	},
	"devDependencies": {
		"@types/node": "24.19.2",
		"playwright-core": "1.56.1",
		"typescript": "6.0.3",
		"vite": "8.3.5"
	}
}
