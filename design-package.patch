index 0000000..07e0856
--- /dev/null
+++ b/packages/design/src/contrast.ts
@@ -0,0 +1,51 @@
+/** WCAG 2 contrast between two OKLCH colours, as the browser would show them in sRGB.
+ *
+ *  A colour outside sRGB is clipped per channel, which is what browsers do today for `oklch()` in an sRGB display; a
+ *  token far outside the gamut would show a different hue than its numbers say, and this clipping would hide it, so
+ *  `inGamut` lets a test refuse such tokens instead. Translucent colours are composited over the background first. */
+
+import type { Oklch } from './tokens.js';
+
+type Rgb = readonly [number, number, number];
+
+/** Linear-light sRGB, each channel nominally from 0 to 1 but not clipped, by Björn Ottosson's OKLab matrices. */
+export function linearSrgb({ l, c, h }: Oklch): Rgb {
+    const hr = (h * Math.PI) / 180;
+    const a = c * Math.cos(hr);
+    const b = c * Math.sin(hr);
+    const lc = (l + 0.3963377774 * a + 0.2158037573 * b) ** 3;
+    const mc = (l - 0.1055613458 * a - 0.0638541728 * b) ** 3;
+    const sc = (l - 0.0894841775 * a - 1.291485548 * b) ** 3;
+    return [
+        4.0767416621 * lc - 3.3077115913 * mc + 0.2309699292 * sc,
+        -1.2684380046 * lc + 2.6097574011 * mc - 0.3413193965 * sc,
+        -0.0041960863 * lc - 0.7034186147 * mc + 1.707614701 * sc,
+    ];
+}
+
+/** True if no channel of the colour lies further than `tolerance` outside sRGB's 0 to 1 (in linear light). The default
+ *  allows only rounding. */
+export function inGamut(color: Oklch, tolerance = 0.002): boolean {
+    return linearSrgb(color).every(ch => ch >= -tolerance && ch <= 1 + tolerance);
+}
+
+const clip = (x: number): number => Math.min(1, Math.max(0, x));
+const encode = (x: number): number => (x <= 0.0031308 ? 12.92 * x : 1.055 * x ** (1 / 2.4) - 0.055);
+const decode = (x: number): number => (x <= 0.04045 ? x / 12.92 : ((x + 0.055) / 1.055) ** 2.4);
+
+/** The colour in gamma-encoded sRGB from 0 to 1, clipped, after compositing over `under` when it is translucent. */
+function shown(color: Oklch, under: Rgb): Rgb {
+    const [r, g, b] = linearSrgb(color);
+    const over = (ch: number, base: number): number => encode(clip(ch)) * color.alpha + base * (1 - color.alpha);
+    return [over(r, under[0]), over(g, under[1]), over(b, under[2])];
+}
+
+const luminance = (rgb: Rgb): number => 0.2126 * decode(rgb[0]) + 0.7152 * decode(rgb[1]) + 0.0722 * decode(rgb[2]);
+
+/** The WCAG 2 contrast ratio, from 1 to 21, of `fg` drawn on `bg`. `bg` must be opaque. */
+export function contrast(fg: Oklch, bg: Oklch): number {
+    const back = shown(bg, [1, 1, 1]);
+    const a = luminance(shown(fg, back));
+    const b = luminance(back);
+    return (Math.max(a, b) + 0.05) / (Math.min(a, b) + 0.05);
+}
diff --git a/packages/design/src/tokens.ts b/packages/design/src/tokens.ts
new file mode 100644
index 0000000..e4d69b5
--- /dev/null
+++ b/packages/design/src/tokens.ts
@@ -0,0 +1,168 @@
+/** Reading W3C design token files (format 2025.10) and compiling them to CSS custom properties.
+ *
+ *  Pure: functions of parsed JSON and strings, no file system. `scripts/build.ts` does the reading and writing. Only the
+ *  token types Yukibana uses are understood; any other `$type`, or a value that does not fit its type, is an error that
+ *  names the token's path, because a token silently dropped from the CSS is a colour that quietly falls back to nothing.
+ */
+
+/** A colour in OKLCH, the only colour space the tokens use. `l` is lightness from 0 to 1, `c` chroma (0 to about 0.37),
+ *  `h` hue in degrees, `alpha` from 0 to 1. */
+export type Oklch = { readonly l: number; readonly c: number; readonly h: number; readonly alpha: number };
+
+/** What one token holds, by its `$type`. A dimension's unit is `px` or `rem`; a duration's is `ms` or `s`. */
+export type TokenValue =
+    | { readonly type: 'color'; readonly color: Oklch }
+    | { readonly type: 'dimension'; readonly value: number; readonly unit: 'px' | 'rem' }
+    | { readonly type: 'duration'; readonly value: number; readonly unit: 'ms' | 's' }
+    | { readonly type: 'fontFamily'; readonly families: readonly string[] }
+    | { readonly type: 'fontWeight'; readonly weight: number }
+    | { readonly type: 'number'; readonly value: number }
+    | { readonly type: 'cubicBezier'; readonly points: readonly [number, number, number, number] };
+
+/** One token: where it sits in the file (`['color', 'code', 'bg']`) and its value. */
+export type Token = { readonly path: readonly string[]; readonly value: TokenValue };
+
+/** Thrown for a token file that is not what this module understands. The message names the token. */
+export class TokenError extends Error {}
+
+const isObject = (v: unknown): v is Record<string, unknown> => typeof v === 'object' && v !== null && !Array.isArray(v);
+const isNumber = (v: unknown): v is number => typeof v === 'number' && Number.isFinite(v);
+
+/** Every token in a parsed token file, in the order the file lists them. A group's `$type` applies to the tokens below
+ *  it unless one says its own. Keys starting with `$` are the format's own and never tokens or groups. */
+export function parseTokens(file: unknown): Token[] {
+    const out: Token[] = [];
+    walk(file, [], undefined, out);
+    return out;
+}
+
+function walk(node: unknown, path: string[], inherited: string | undefined, out: Token[]): void {
+    const where = path.join('.') || '(root)';
+    if (!isObject(node)) throw new TokenError(`${where}: expected a group or a token, found ${JSON.stringify(node)}`);
+    const own = node['$type'];
+    if (own !== undefined && typeof own !== 'string') throw new TokenError(`${where}: $type must be a string`);
+    const type = own ?? inherited;
+    if ('$value' in node) {
+        if (type === undefined) throw new TokenError(`${where}: no $type on the token or any group above it`);
+        out.push({ path, value: valueOf(node['$value'], type, where) });
+        return;
+    }
+    for (const [key, child] of Object.entries(node)) if (!key.startsWith('$')) walk(child, [...path, key], type, out);
+}
+
+function valueOf(v: unknown, type: string, where: string): TokenValue {
+    const bad = (what: string): never => {
+        throw new TokenError(`${where}: ${what}, found ${JSON.stringify(v)}`);
+    };
+    switch (type) {
+        case 'color': {
+            if (!isObject(v) || v['colorSpace'] !== 'oklch') return bad('a color must be { colorSpace: "oklch", components: [l, c, h] }');
+            const comps = v['components'];
+            const [l, c, h, extra] = Array.isArray(comps) ? (comps as unknown[]) : [];
+            if (!isNumber(l) || !isNumber(c) || !isNumber(h) || extra !== undefined) return bad('components must be three numbers');
+            const alpha = v['alpha'] ?? 1;
+            if (!isNumber(alpha) || alpha < 0 || alpha > 1) return bad('alpha must be a number from 0 to 1');
+            if (l < 0 || l > 1) return bad('lightness must be from 0 to 1');
+            if (c < 0) return bad('chroma cannot be negative');
+            return { type, color: { l, c, h, alpha } };
+        }
+        case 'dimension': {
+            if (!isObject(v) || !isNumber(v['value']) || (v['unit'] !== 'px' && v['unit'] !== 'rem')) return bad('a dimension must be { value, unit: "px" | "rem" }');
+            return { type, value: v['value'], unit: v['unit'] };
+        }
+        case 'duration': {
+            if (!isObject(v) || !isNumber(v['value']) || (v['unit'] !== 'ms' && v['unit'] !== 's')) return bad('a duration must be { value, unit: "ms" | "s" }');
+            return { type, value: v['value'], unit: v['unit'] };
+        }
+        case 'fontFamily': {
+            const list: unknown[] = typeof v === 'string' ? [v] : Array.isArray(v) ? (v as unknown[]) : [];
+            const families = list.filter((f): f is string => typeof f === 'string' && f !== '');
+            if (families.length === 0 || families.length !== list.length) return bad('a font family must be a name or a list of names');
+            return { type, families };
+        }
+        case 'fontWeight':
+            if (!isNumber(v) || v < 1 || v > 1000) return bad('a font weight must be a number from 1 to 1000');
+            return { type, weight: v };
+        case 'number':
+            if (!isNumber(v)) return bad('expected a number');
+            return { type, value: v };
+        case 'cubicBezier': {
+            const [x1, y1, x2, y2, extra] = Array.isArray(v) ? (v as unknown[]) : [];
+            if (!isNumber(x1) || !isNumber(y1) || !isNumber(x2) || !isNumber(y2) || extra !== undefined) return bad('a cubic bezier must be four numbers');
+            if (x1 < 0 || x1 > 1 || x2 < 0 || x2 > 1) return bad('the x coordinates of a cubic bezier must be from 0 to 1');
+            return { type, points: [x1, y1, x2, y2] };
+        }
+        default:
+            return bad(`the type ${type} is not one this package compiles`);
+    }
+}
+
+/** The custom property a token compiles to: `--yk-` and its path joined by `-`, without the leading `color` group, so
+ *  `color.code.bg` is `--yk-code-bg` and `radius.md` is `--yk-radius-md`. */
+export function propertyName(path: readonly string[]): string {
+    const parts = path[0] === 'color' ? path.slice(1) : path;
+    return '--yk-' + parts.join('-');
+}
+
+const trim = (n: number, digits: number): string => String(Number(n.toFixed(digits)));
+
+/** A colour as CSS, `oklch(L% C H)` or `oklch(L% C H / A)`, lightness in percent so a reader sees the step. */
+export function cssColor({ l, c, h, alpha }: Oklch): string {
+    const body = `${trim(l * 100, 2)}% ${trim(c, 4)} ${trim(h, 2)}`;
+    return alpha === 1 ? `oklch(${body})` : `oklch(${body} / ${trim(alpha, 3)})`;
+}
+
+const quoteFamily = (f: string): string => (/^[a-z-]+$/.test(f) ? f : `'${f.replaceAll("'", "\\'")}'`);
+
+/** A token's value as CSS. Generic family names (`monospace`, `ui-sans-serif`) stay unquoted, as CSS requires. */
+export function cssValue(v: TokenValue): string {
+    if (v.type === 'color') return cssColor(v.color);
+    if (v.type === 'dimension' || v.type === 'duration') return `${trim(v.value, 4)}${v.unit}`;
+    if (v.type === 'fontFamily') return v.families.map(quoteFamily).join(', ');
+    if (v.type === 'fontWeight') return String(v.weight);
+    if (v.type === 'number') return trim(v.value, 4);
+    return `cubic-bezier(${v.points.map(p => trim(p, 4)).join(', ')})`;
+}
+
+/** The stylesheet for both themes: one `:root` rule in which each colour is `light-dark(light, dark)` and every other
+ *  token is its value, then `data-theme` rules that pin a scheme. A page follows the system's scheme unless its root
+ *  says `data-theme="light"` or `"dark"`.
+ *
+ *  `dark` may only override colours that `light` has: a dark token with no light counterpart, or a non-colour in the
+ *  dark file, is a `TokenError`, so the two files cannot drift apart. A light colour with no dark override is the same
+ *  in both themes. */
+export function compileCss(light: readonly Token[], dark: readonly Token[]): string {
+    const key = (t: Token): string => t.path.join('.');
+    const darkByPath = new Map(dark.map(t => [key(t), t]));
+    const lightPaths = new Set(light.map(key));
+    for (const t of dark) {
+        if (!lightPaths.has(key(t))) throw new TokenError(`${key(t)}: the dark theme overrides a token the base file does not have`);
+        if (t.value.type !== 'color') throw new TokenError(`${key(t)}: the dark theme may only override colours`);
+    }
+    const lines = light.map(t => {
+        const d = darkByPath.get(key(t));
+        const value = t.value.type === 'color' && d !== undefined ? `light-dark(${cssValue(t.value)}, ${cssValue(d.value)})` : cssValue(t.value);
+        return `    ${propertyName(t.path)}: ${value};`;
+    });
+    return [
+        '/* Generated by packages/design/scripts/build.ts from tokens/base.tokens.json and tokens/dark.tokens.json. Do not edit: change the tokens and run `pnpm --filter @yukibana/design build`. */',
+        ':root {',
+        '    color-scheme: light dark;',
+        ...lines,
+        '}',
+        ":root[data-theme='light'] {",
+        '    color-scheme: light;',
+        '}',
+        ":root[data-theme='dark'] {",
+        '    color-scheme: dark;',
+        '}',
+        '',
+    ].join('\n');
+}
+
+/** A colour token by its path in the given list, for tests and tools. Throws if it is missing or not a colour. */
+export function colorAt(tokens: readonly Token[], path: string): Oklch {
+    const t = tokens.find(x => x.path.join('.') === path);
+    if (t === undefined || t.value.type !== 'color') throw new TokenError(`${path}: no such colour token`);
+    return t.value.color;
+}
diff --git a/packages/design/tests/tokens.test.ts b/packages/design/tests/tokens.test.ts
new file mode 100644
index 0000000..f3f6b17
--- /dev/null
+++ b/packages/design/tests/tokens.test.ts
@@ -0,0 +1,147 @@
+import { readFileSync } from 'node:fs';
+import { describe, expect, it } from 'vitest';
+import { contrast, inGamut } from '../src/contrast.js';
+import { colorAt, compileCss, cssValue, parseTokens, propertyName, TokenError, type Token } from '../src/tokens.js';
+
+const file = (p: string): unknown => JSON.parse(readFileSync(new URL('../' + p, import.meta.url), 'utf8'));
+const light = parseTokens(file('tokens/base.tokens.json'));
+const dark = parseTokens(file('tokens/dark.tokens.json'));
+/** The dark theme as a full set: every light token, with the dark file's colours in place. */
+const darkFull: Token[] = light.map(t => dark.find(d => d.path.join('.') === t.path.join('.')) ?? t);
+
+describe('the token files', () => {
+    it('compile to the css/tokens.css that is committed, so apps outside this repository can copy it', () => {
+        expect(readFileSync(new URL('../css/tokens.css', import.meta.url), 'utf8')).toBe(compileCss(light, dark));
+    });
+
+    it('give every colour of the dark theme a light counterpart, and only colours', () => {
+        expect(() => compileCss(light, dark)).not.toThrow();
+        expect(dark.every(t => t.value.type === 'color')).toBe(true);
+    });
+
+    // Several chosen colours (the green accent, the chip tints) sit a hair outside sRGB, at most 0.052 of a channel in
+    // linear light. The browser clips that per channel, which shifts nothing a person can see, and the colours were picked
+    // by eye as the browser showed them. A colour further out would change hue when clipped, so it is refused.
+    it('hold only colours a screen can show without a visible shift when the browser clips them', () => {
+        const outside = [...light, ...dark].filter(t => t.value.type === 'color' && !inGamut(t.value.color, 0.06)).map(t => t.path.join('.'));
+        expect(outside).toEqual([]);
+    });
+});
+
+/** Text that must be readable: WCAG AA, 4.5:1. */
+const TEXT: [string, string][] = [
+    ['ink', 'bg'],
+    ['ink', 'surface'],
+    ['ink', 'sunken'],
+    ['soft', 'bg'],
+    ['soft', 'surface'],
+    ['soft', 'sunken'],
+    ['accent-strong', 'bg'],
+    ['accent-strong', 'surface'],
+    ['accent-strong', 'accent-bg'],
+    ['on-accent', 'accent'],
+    ['on-accent', 'danger'],
+    ['danger', 'surface'],
+    ['danger', 'danger-bg'],
+    ['warn', 'warn-bg'],
+    ['info', 'info-bg'],
+    ['on-toast', 'toast'],
+    ['code.ink', 'code.bg'],
+    ['code.keyword', 'code.bg'],
+    ['code.function', 'code.bg'],
+    ['code.string', 'code.bg'],
+    ['code.number', 'code.bg'],
+    ['code.comment', 'code.bg'],
+    ['soft', 'code.bar'],
+    ...['blue', 'violet', 'pink', 'teal', 'yellow', 'green', 'grey'].map((h): [string, string] => [`chip.${h}.fg`, `chip.${h}.bg`]),
+];
+/** Things that must be seen but are not text: controls' borders, the focus ring, icons. WCAG 1.4.11, 3:1. */
+const UI: [string, string][] = [
+    ['line-strong', 'surface'],
+    ['line-strong', 'bg'],
+    ['accent', 'surface'],
+    ['accent', 'code.bg'],
+    ['ink', 'bg'],
+    ['ok', 'surface'],
+    ['ok', 'bg'],
+];
+
+describe.each([
+    ['light', light],
+    ['dark', darkFull],
+])('in the %s theme', (_, set) => {
+    it.each(TEXT)('%s on %s is readable text (4.5:1)', (fg, bg) => {
+        expect(contrast(colorAt(set, `color.${fg}`), colorAt(set, `color.${bg}`))).toBeGreaterThanOrEqual(4.5);
+    });
+    it.each(UI)('%s on %s is visible as a control or icon (3:1)', (fg, bg) => {
+        expect(contrast(colorAt(set, `color.${fg}`), colorAt(set, `color.${bg}`))).toBeGreaterThanOrEqual(3);
+    });
+});
+
+describe('reading a token file', () => {
+    it('takes the type from the nearest group that names one', () => {
+        expect(parseTokens({ a: { $type: 'number', b: { c: { $value: 2 } }, d: { $type: 'fontWeight', $value: 700 } } })).toEqual([
+            { path: ['a', 'b', 'c'], value: { type: 'number', value: 2 } },
+            { path: ['a', 'd'], value: { type: 'fontWeight', weight: 700 } },
+        ]);
+    });
+
+    it.each([
+        ['a token with no type anywhere above it', { a: { $value: 1 } }, 'a: no $type'],
+        ['a colour in another colour space', { a: { $type: 'color', $value: { colorSpace: 'srgb', components: [1, 0, 0] } } }, 'a: a color must be'],
+        ['a lightness given in percent', { a: { $type: 'color', $value: { colorSpace: 'oklch', components: [50, 0.1, 160] } } }, 'a: lightness must be from 0 to 1'],
+        ['a dimension in em', { a: { $type: 'dimension', $value: { value: 1, unit: 'em' } } }, 'a: a dimension must be'],
+        ['a type this package does not compile', { a: { $type: 'shadow', $value: {} } }, 'a: the type shadow'],
+        ['a token that is not an object', { a: { b: 3 } }, 'a.b: expected a group or a token'],
+    ])('refuses %s, naming the token', (_, input, message) => {
+        expect(() => parseTokens(input)).toThrow(TokenError);
+        expect(() => parseTokens(input)).toThrow(message);
+    });
+});
+
+describe('compiling to CSS', () => {
+    it.each([
+        [['color', 'bg'], '--yk-bg'],
+        [['color', 'code', 'bg'], '--yk-code-bg'],
+        [['radius', 'md'], '--yk-radius-md'],
+        [['font', 'family', 'mono'], '--yk-font-family-mono'],
+    ])('names %j %s', (path, name) => {
+        expect(propertyName(path)).toBe(name);
+    });
+
+    it.each([
+        [{ type: 'color', color: { l: 0.5, c: 0.115, h: 162, alpha: 1 } } as const, 'oklch(50% 0.115 162)'],
+        [{ type: 'color', color: { l: 0.8, c: 0.03, h: 260, alpha: 0.16 } } as const, 'oklch(80% 0.03 260 / 0.16)'],
+        [{ type: 'dimension', value: 8, unit: 'px' } as const, '8px'],
+        [{ type: 'duration', value: 120, unit: 'ms' } as const, '120ms'],
+        [{ type: 'fontFamily', families: ['JetBrains Mono', 'ui-monospace', 'monospace'] } as const, "'JetBrains Mono', ui-monospace, monospace"],
+        [{ type: 'cubicBezier', points: [0.2, 0, 0, 1] } as const, 'cubic-bezier(0.2, 0, 0, 1)'],
+    ])('writes %j as %s', (value, css) => {
+        expect(cssValue(value)).toBe(css);
+    });
+
+    it('pairs each colour with its dark value and leaves other tokens alone', () => {
+        const css = compileCss(
+            [
+                { path: ['color', 'ink'], value: { type: 'color', color: { l: 0.2, c: 0, h: 0, alpha: 1 } } },
+                { path: ['radius', 'md'], value: { type: 'dimension', value: 8, unit: 'px' } },
+            ],
+            [{ path: ['color', 'ink'], value: { type: 'color', color: { l: 0.9, c: 0, h: 0, alpha: 1 } } }],
+        );
+        expect(css).toContain('    --yk-ink: light-dark(oklch(20% 0 0), oklch(90% 0 0));');
+        expect(css).toContain('    --yk-radius-md: 8px;');
+    });
+
+    it('refuses a dark theme that overrides a token the light theme lacks', () => {
+        expect(() => compileCss([], [{ path: ['color', 'ink'], value: { type: 'color', color: { l: 0.9, c: 0, h: 0, alpha: 1 } } }])).toThrow('does not have');
+    });
+});
+
+describe('contrast', () => {
+    it('is 21 for black on white and 1 for a colour on itself', () => {
+        const black = { l: 0, c: 0, h: 0, alpha: 1 };
+        const white = { l: 1, c: 0, h: 0, alpha: 1 };
+        expect(contrast(black, white)).toBeCloseTo(21, 1);
+        expect(contrast(white, white)).toBeCloseTo(1, 5);
+    });
+});
