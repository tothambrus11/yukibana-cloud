{
  "name": "yukibana-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "prepare": "svelte-kit sync",
    "dev": "vite dev --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "svelte-kit sync && oxlint --type-aware --deny-warnings"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@sveltejs/adapter-cloudflare": "^8.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^22.20.4",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2001",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.147.0"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "aws4fetch": "^1.0.20",
    "jose": "^6.2.12",
    "postgres": "^3.4.7"
  }
}
