{
  "name": "@yukibana/cli",
  "version": "0.1.0",
  "description": "Build, publish, submit, download and assemble Yukibana course projects: a command line tool, and the library the IDE extension uses.",
  "license": "MIT",
  "type": "module",
  "main": "dist/library.js",
  "types": "dist/library.d.ts",
  "exports": {
    ".": {
      "types": "./dist/library.d.ts",
      "default": "./dist/library.js"
    },
    "./config": {
      "types": "./dist/lib/yukibana.d.ts",
      "default": "./dist/lib/yukibana.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "config": [
        "dist/lib/yukibana.d.ts"
      ]
    }
  },
  "bin": {
    "yukibana": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "ignore": "^7.0.13",
    "modern-tar": "^0.8.6",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  }
}
