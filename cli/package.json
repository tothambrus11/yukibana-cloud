{
  "name": "@yukibana/cli",
  "version": "0.1.0",
  "description": "Build, publish, submit, download and assemble Yukibana course projects: a command line tool, and the library the IDE extension uses.",
  "license": "MIT",
  "type": "module",
  "main": "dist/library.js",
  "types": "dist/library.d.ts",
  "exports": {
    ".": {
      "types": "./dist/library.d.ts",
      "default": "./dist/library.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "yukibana": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
