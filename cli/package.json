{
  "name": "@yukibana/cli",
  "version": "0.1.0",
  "description": "Build a course project's starter and teacher archives, and publish them to Yukibana Cloud.",
  "license": "MIT",
  "type": "module",
  "bin": { "yukibana": "dist/index.js" },
  "files": ["dist"],
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
